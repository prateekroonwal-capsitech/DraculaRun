[node name="PlayView" type="Control" parent="SafeArea/Layout"]
editor_description = "~68%: the 3D road shows through here. Touches starting here are lane swipes. Keep it free of UI except transient labels."
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 68.0
mouse_filter = 2

