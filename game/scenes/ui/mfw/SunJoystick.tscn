[node name="SunJoystick" type="Control" node_paths=PackedStringArray("body", "ring", "knob", "target_marker", "blocked_rim")]
editor_description = "Sun-position dial (bottom-right of the SafeAreaMargin; left_handed mirrors it). The knob shows the sun's current angle: X = azimuth range, Y = elevation (HIGH top / LOW bottom). Ring look: Body/Ring (DialRing) exports; knob / marker / flash: their StyleBoxes."
