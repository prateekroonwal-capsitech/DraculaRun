[node name="DraculaVisual" node_paths=PackedStringArray("animation_tree") instance=ExtResource("1_glb")]
editor_description = "Inherited scene of Dracula/dracula.glb (don't edit the .glb). Rotated 180° on Y: the model faces +Z, the game's forward is −Z. Feel: walk/run clip speeds and blend time on this root; graph in AnimationTree. Colours: the .glb materials, duplicated per surface in game/assets/materials/dracula/ (each with next_pass dracula_rim → dracula_outline). Mesh on render layer 2 (Character), lit extra by CharacterLight (cull mask = Character only)."
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)
script = ExtResource("2_vis")
animation_tree = NodePath("AnimationTree")

