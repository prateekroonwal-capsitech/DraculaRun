[node name="Level04" type="Node3D" unique_id=1311650315 node_paths=PackedStringArray("start", "goal", "grid")]
editor_description = "Village Watch: dusk village street. Two patrolling villagers (Villagers/*, each with its Path3D patrol). Sections: The sun runs by itself on a loop (Auto sun group: auto_sun_keys, hold / move times); the player times moves between holds. A: reach shade that survives the first sweep, B hide and let the red villager pass, C hide in the barrels while the sun sweeps, slip past the blue lantern-bearer. Run level/LevelValidatorRunner.tscn (incl. the patrol check) after edits."
script = ExtResource("1_ShadowLevel")
level_number = 4
level_title = "Village Watch"
hint = "The sun moves by itself here: watch the countdown and hide in time."
azimuth_min = -70
azimuth_max = 70
elevation_min = 18
elevation_max = 40
min_sun_adjustments = 2
sun_start_azimuth = -45
sun_start_elevation = 25
auto_sun = true
auto_sun_keys = PackedVector2Array(-45, 25, -15, 20.4, 60, 18, -17.5, 18)
auto_sun_hold_time = 8
auto_sun_move_time = 3
auto_sun_first_hold_bonus = 16.0
tutorial_steps = PackedStringArray("Dusk in the village: the sun moves on its own here. You can't steer it.", "The chained sun dial counts down to the sun's next move.", "Before it moves, get Dracula into shade that will last, or into a hiding spot.", "Villagers patrol with lanterns. Stay out of their vision cones.", "Tap a haystack, cart, crates or barrels to hide: unseen and safe from the sun.", "Tap anywhere to step out again. Reach the crypt!")
tutorial_step_time = 4.0
start = NodePath("Start")
goal = NodePath("Goal")
grid = NodePath("ShadeGrid")

