[node name="Level04" type="Node3D" node_paths=PackedStringArray("start", "goal", "grid")]
editor_description = "Village Edge: a gentle introduction to the village. Short dusk street, ONE villager walking straight across the street and back (vision_range 4.5 m, small lantern radius). A: one sun adjustment, as in levels 1-3. B: the haystack sits beside the villager's crossing: hide while he looks your way, go when he turns his back. C: open shade to the crypt. Run level/LevelValidatorRunner.tscn after edits."
script = ExtResource("1_ShadowLevel")
level_number = 4
level_title = "Village Edge"
hint = "Tap the haystack to hide from the villager."
sun_start_azimuth = -45
sun_start_elevation = 28
azimuth_min = -70
azimuth_max = 70
elevation_min = 20
elevation_max = 40
min_sun_adjustments = 1
start = NodePath("Start")
goal = NodePath("Goal")
grid = NodePath("ShadeGrid")
tutorial_steps = PackedStringArray("Welcome to the village. Turn the sun to make a shadow path, as before.", "A villager crosses the street. The cone on the ground shows where he looks.", "Tap the haystack to hide. He can't see you in there.", "When he turns his back, tap ahead to step out and run past.")
tutorial_step_time = 4.5

