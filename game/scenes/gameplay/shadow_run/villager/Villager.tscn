[node name="Villager" node_paths=PackedStringArray("body_mesh", "anim", "lantern_attach", "lantern_light", "eye", "vision_cone", "meter", "meter_label") instance=ExtResource("1_glb")]
editor_description = "Inherited scene of assets/models/Villager/villager.glb (don't edit the .glb; clip loop modes are set in its .import). The model faces +Z; VillagerController turns the root. Place one under the level's Villagers node and assign patrol_path (a Path3D in the level). Recolour with the Clothing exports (per-instance shader parameters). Mesh on render layer 2 (Character) so CharacterLight keeps it readable in shade."
script = ExtResource("2_ctrl")
body_mesh = NodePath("Armature/Skeleton3D/DraculaMesh")
anim = NodePath("AnimationPlayer")
lantern_attach = NodePath("Armature/Skeleton3D/LanternAttach")
lantern_light = NodePath("Armature/Skeleton3D/LanternAttach/LanternLight")
eye = NodePath("Eye")
vision_cone = NodePath("VisionCone")
meter = NodePath("Meter")
meter_label = NodePath("MeterLabel")

