# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables — copy to .env and fill in values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase ──────────────────────────────────────────────────────────────────
# Path to service account key JSON (local dev only)
# On Cloud Functions / Cloud Run, Application Default Credentials are used automatically
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Firebase project settings
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ── Studio ────────────────────────────────────────────────────────────────────
# Game ID used for studio-level auth hooks (onCreate, onDelete)
STUDIO_GAME_ID=studio

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
